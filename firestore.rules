rules_version = '2';

// Verth Firestore security rules (v2, hardened).
//
// Principles
//  - Only signed-in users with a confirmed email can touch data.
//  - New members join as "pending" and see nothing until an admin approves them.
//  - Only active members can read a circle, its members and its checks.
//  - Names on checks must match the real member records (no spoofing "the CEO").
//  - A check can only be answered by the named person, once, before it expires,
//    with a device signature attached (the requester's app verifies it).
//  - Every write is limited to known fields with checked formats and sizes.
//  - Nothing can be deleted from the verification log. Plans can't be changed from the app.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function me() { return request.auth.uid; }
    function circlePath(cid) { return /databases/$(database)/documents/circles/$(cid); }
    function memberPath(cid, uid) { return /databases/$(database)/documents/circles/$(cid)/members/$(uid); }
    function activeMember(cid, uid) {
      return exists(memberPath(cid, uid)) && get(memberPath(cid, uid)).data.status == 'active';
    }
    function isMember(cid) { return signedIn() && activeMember(cid, me()); }
    function isAdmin(cid) { return isMember(cid) && get(memberPath(cid, me())).data.role == 'admin'; }
    function isAdminAfter(cid) {
      return signedIn()
        && getAfter(memberPath(cid, me())).data.role == 'admin'
        && getAfter(memberPath(cid, me())).data.status == 'active';
    }
    // Plans, seats and billing are written only by the payments server (never by the app).
    function withinLimit(c, n) {
      return (c.plan == 'team' && n <= 2000)
        || (c.plan == 'family' && n <= 10)
        || (c.plan == 'free' && n <= 5);
    }
    // Family and Team plans give every active member unlimited scam checks.
    function paidCircleFor(uid, cid) {
      return cid is string && activeMember(cid, uid) && get(circlePath(cid)).data.plan in ['family', 'team'];
    }
    // 7-day free trial: everything unlimited for a week from sign-up (the profile's createdAt is
    // set by the database clock and can't be changed). Keep in step with TRIAL_DAYS in src/app.js.
    function inTrial(uid) {
      let u = get(/databases/$(database)/documents/users/$(uid)).data;
      return u.get('createdAt', null) is timestamp && request.time < u.createdAt + duration.value(7, 'd');
    }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function onlyChanges(keys) { return changed().hasOnly(keys); }
    function text(v, n) { return v is string && v.size() > 0 && v.size() <= n; }
    function validInvite(code) { return code is string && code.matches('^[A-HJKMNP-Z2-9]{8}$'); }
    function validPub(p) {
      return p is map && p.keys().hasOnly(['x', 'y']) && p.keys().hasAll(['x', 'y'])
        && p.x is string && p.x.matches('^[A-Za-z0-9_-]{43}$')
        && p.y is string && p.y.matches('^[A-Za-z0-9_-]{43}$');
    }
    function validDevice(d, n) {
      return d is map && d.keys().hasOnly(['dh', 'sig', 'n', 'at', 'label']) && d.keys().hasAll(['dh', 'sig', 'n', 'at', 'label'])
        && validPub(d.dh) && validPub(d.sig) && d.n == n && d.at == request.time && text(d.label, 40);
    }
    // Anti-flood: each person can log at most one check every 5 seconds. The app writes
    // users/{uid}/meters/checks in the same batch as the check, stamped with the request time.
    function checkMeter() { return /databases/$(database)/documents/users/$(me())/meters/checks; }
    function throttledCheck() {
      return existsAfter(checkMeter()) && getAfter(checkMeter()).data.at == request.time
        && (!exists(checkMeter()) || get(checkMeter()).data.at < request.time - duration.value(5, 's'));
    }
    // Indian mobiles must be +91 and 10 digits starting 6-9; other countries +code and 7-15 digits in all.
    function validPhone(p) {
      return p is string && (p.matches('^[+]91[6-9][0-9]{9}$') || (p.matches('^[+][1-9][0-9]{6,14}$') && !p.matches('^[+]91.*')));
    }
    // Profile photos: a small JPEG (256×256) as a data address, nothing else.
    function validPhoto(p) { return p == null || (p is string && p.size() <= 80000 && p.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')); }
    function validPerson(d) {
      return (!('gender' in d) || d.gender in ['female', 'male', 'other', 'unsaid'])
        && (!('dob' in d) || (d.dob is string && d.dob.matches('^(19|20)[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')))
        && (!('country' in d) || (d.country is string && d.country.matches('^[A-Z]{2}$')));
    }
    function todayIST() { return string(int((request.time.toMillis() + 19800000) / 86400000)); }
    // Company email lock: free email providers can never be a company domain.
    function freeMail() {
      return ['gmail.com', 'googlemail.com', 'yahoo.com', 'yahoo.co.in', 'yahoo.in', 'ymail.com', 'rocketmail.com',
        'outlook.com', 'outlook.in', 'hotmail.com', 'hotmail.co.in', 'live.com', 'live.in', 'msn.com',
        'icloud.com', 'me.com', 'mac.com', 'rediffmail.com', 'rediff.com', 'aol.com', 'proton.me', 'protonmail.com',
        'pm.me', 'zoho.com', 'zohomail.in', 'zohomail.com', 'yandex.com', 'yandex.ru', 'mail.com', 'gmx.com', 'gmx.net',
        'tutanota.com', 'tuta.io', 'hey.com', 'fastmail.com', 'inbox.com', 'mail.ru', 'qq.com', '163.com', 'sify.com', 'indiatimes.com'];
    }
    function myEmail() { return request.auth.token.email.lower(); }
    function myDomain() { return myEmail().split('@')[1]; }
    function validDomain(d) {
      return d is string && d.size() <= 100 && d.matches('^[a-z0-9-]+([.][a-z0-9-]+)+$') && !(d in freeMail());
    }
    // Who may ask to join: with the company lock on, only emails on that domain; with the
    // staff list on, only emails the admins added to the list.
    function joinAllowed(cid) {
      let c = get(circlePath(cid)).data;
      return (c.get('domain', null) == null || myDomain() == c.domain)
        && (c.get('listOnly', false) != true
            || exists(/databases/$(database)/documents/circles/$(cid)/allow/$(myEmail())));
    }
    function twoAdmins(cid) { return get(circlePath(cid)).data.get('twoAdmins', false) == true; }
    function validUpi(u) { return u is string && u.size() <= 100 && u.matches('^[a-z0-9._-]{2,64}@[a-z][a-z0-9]{1,30}$'); }
    function dailyPath(kind) {
      return /databases/$(database)/documents/users/$(me())/daily/$((kind == 'p' ? 'pay-' : 'chat-') + todayIST());
    }
    // The person's daily allowance was counted in the same write.
    function metered(kind) { return getAfter(dailyPath(kind)).data.at == request.time; }
    function channels() { return ['WhatsApp', 'Phone call', 'Video call', 'SMS', 'Email', 'In person', 'Other', 'Call']; }

    // ---------- your profile ----------
    match /users/{uid} {
      allow read: if signedIn() && me() == uid;
      allow create: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'gender', 'dob', 'country', 'plan', 'circles', 'activeCircle', 'onboarded', 'agreedAt', 'createdAt'])
        && validPerson(request.resource.data)
        && text(request.resource.data.name, 60)
        && (!('phone' in request.resource.data) || validPhone(request.resource.data.phone))
        && (!('agreedAt' in request.resource.data) || request.resource.data.agreedAt == request.time)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.plan == 'free'
        && request.resource.data.circles == []
        && request.resource.data.onboarded == false
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && me() == uid
        && onlyChanges(['name', 'phone', 'gender', 'dob', 'country', 'photo', 'circles', 'activeCircle', 'onboarded', 'upgradeInterest'])
        && validPerson(request.resource.data)
        && validPhoto(request.resource.data.get('photo', null))
        && (!('phone' in request.resource.data) || validPhone(request.resource.data.phone))
        && text(request.resource.data.name, 60)
        && request.resource.data.circles is list && request.resource.data.circles.size() <= 20
        && request.resource.data.onboarded is bool;
      allow delete: if false;

      // Daily scam-check counter. The document name must be today's date (India time), so it
      // can't be reset by writing a different day, and free accounts stop at 2 a day.
      match /usage/{day} {
        allow get: if signedIn() && me() == uid;
        allow create: if signedIn() && me() == uid && day == todayIST()
          && request.resource.data.keys().hasOnly(['scans', 'at'])
          && request.resource.data.scans == 1
          && request.resource.data.at == request.time;
        allow update: if signedIn() && me() == uid && day == todayIST()
          && onlyChanges(['scans', 'at', 'via'])
          && request.resource.data.scans == resource.data.scans + 1
          && request.resource.data.at == request.time
          && (request.resource.data.scans <= 2
              || get(/databases/$(database)/documents/users/$(uid)).data.plan != 'free'
              || inTrial(uid)
              || paidCircleFor(uid, request.resource.data.get('via', null)));
      }

      // Photo and screenshot checks: 5 free in total, then unlimited on a paid plan (your own,
      // or a Family or Team circle you're an active member of). Counts only go up by one.
      match /meters/{meter} {
        allow get: if signedIn() && me() == uid;
        allow create: if signedIn() && me() == uid && meter == 'photos'
          && request.resource.data.keys().hasOnly(['count', 'at'])
          && request.resource.data.count == 1
          && request.resource.data.at == request.time;
        allow update: if signedIn() && me() == uid && meter == 'photos'
          && onlyChanges(['count', 'at', 'via'])
          && request.resource.data.count == resource.data.count + 1
          && request.resource.data.at == request.time
          && (request.resource.data.count <= 5
              || get(/databases/$(database)/documents/users/$(uid)).data.plan != 'free'
              || inTrial(uid)
              || paidCircleFor(uid, request.resource.data.get('via', null)));
        allow delete: if false;
      }
      // Daily allowance for private chat (12 messages) and Pay safely (3 payments) on the free
      // plan. The document name must be today's date (India time); counts only go up by one,
      // and a Family or Team circle the person is active in lifts the limit (named in "via").
      match /daily/{key} {
        allow get: if signedIn() && me() == uid;
        allow create: if signedIn() && me() == uid && key in ['chat-' + todayIST(), 'pay-' + todayIST()]
          && request.resource.data.keys().hasOnly(['count', 'at', 'via'])
          && request.resource.data.count == 1
          && request.resource.data.at == request.time;
        allow update: if signedIn() && me() == uid && key in ['chat-' + todayIST(), 'pay-' + todayIST()]
          && onlyChanges(['count', 'at', 'via'])
          && request.resource.data.count == resource.data.count + 1
          && request.resource.data.at == request.time
          && (request.resource.data.count <= (key.matches('^pay-.*') ? 3 : 12)
              || get(/databases/$(database)/documents/users/$(uid)).data.plan != 'free'
              || inTrial(uid)
              || paidCircleFor(uid, request.resource.data.get('via', null)));
        allow delete: if false;
      }
      match /meters/checks {
        allow get: if signedIn() && me() == uid;
        allow create, update: if signedIn() && me() == uid
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at == request.time
          && (resource == null || resource.data.at < request.time - duration.value(5, 's'));
        allow delete: if false;
      }
    }

    // ---------- community scam reports ----------
    // Only a SHA-256 fingerprint of the reported link, number or message is stored, never the
    // content itself. One report per person per item; anyone signed in can see the count.
    match /reports/{fp} {
      // Automatic flags: recorded when Verth's own check finds a scam (high risk), once per person.
      match /auto/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && uid == me()
          && fp.matches('^[a-f0-9]{64}$')
          && request.resource.data.keys().hasOnly(['kind', 'at'])
          && request.resource.data.kind in ['link', 'phone', 'message']
          && request.resource.data.at == request.time;
        allow update, delete: if false;
      }
      match /by/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && uid == me()
          && fp.matches('^[a-f0-9]{64}$')
          && request.resource.data.keys().hasOnly(['kind', 'at'])
          && request.resource.data.kind in ['link', 'phone', 'message']
          && request.resource.data.at == request.time;
        allow delete: if signedIn() && uid == me();
        allow update: if false;
      }
    }

    // ---------- invite codes ----------
    // Look up one code you were given; listing all codes is impossible.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if validInvite(code)
        && request.resource.data.keys().hasOnly(['circleId', 'circleName', 'type', 'domain', 'createdBy', 'createdAt'])
        && request.resource.data.get('domain', null) == getAfter(circlePath(request.resource.data.circleId)).data.get('domain', null)
        && request.resource.data.createdBy == me()
        && request.resource.data.createdAt == request.time
        && text(request.resource.data.circleName, 60)
        && request.resource.data.type in ['org', 'family']
        && getAfter(circlePath(request.resource.data.circleId)).data.inviteCode == code
        && isAdminAfter(request.resource.data.circleId);
      allow delete: if isAdmin(resource.data.circleId);
      // Kept in step with the circle's company lock, so people see it before asking to join.
      allow update: if isAdmin(resource.data.circleId)
        && onlyChanges(['domain'])
        && request.resource.data.domain == getAfter(circlePath(resource.data.circleId)).data.get('domain', null);
    }

    // ---------- circles ----------
    match /circles/{cid} {
      allow read: if isMember(cid);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'type', 'ownerUid', 'inviteCode', 'joinOpen', 'plan', 'memberCount', 'createdAt'])
        && request.resource.data.ownerUid == me()
        && text(request.resource.data.name, 60)
        && request.resource.data.type in ['org', 'family']
        && validInvite(request.resource.data.inviteCode)
        && request.resource.data.joinOpen == true
        && request.resource.data.plan == 'free'
        && request.resource.data.memberCount == 1
        && request.resource.data.createdAt == request.time
        && existsAfter(memberPath(cid, me()));

      // Joining (as pending): exactly one more person, yourself, within the plan limit, while joining is open.
      allow update: if signedIn()
        && onlyChanges(['memberCount'])
        && request.resource.data.memberCount == resource.data.memberCount + 1
        && (withinLimit(resource.data, request.resource.data.memberCount)
            || (request.resource.data.memberCount <= 25 && inTrial(resource.data.ownerUid)))
        && resource.data.joinOpen == true
        && !exists(memberPath(cid, me()))
        && existsAfter(memberPath(cid, me()));

      // Leaving, or an admin removing someone: exactly one fewer, and only together with
      // deleting that person's member record (named in lastRemoved), so the count can't be faked.
      allow update: if signedIn()
        && onlyChanges(['memberCount', 'lastRemoved'])
        && request.resource.data.memberCount == resource.data.memberCount - 1
        && request.resource.data.memberCount >= 1
        && request.resource.data.lastRemoved is string
        && exists(memberPath(cid, request.resource.data.lastRemoved))
        && !existsAfter(memberPath(cid, request.resource.data.lastRemoved))
        && (request.resource.data.lastRemoved == me() || isAdmin(cid));

      // Admins: rename, change the invite code, open or close joining, and (organisations only)
      // the company email lock, the staff list and two-admin approval. The company lock can only be
      // set to the admin's own verified email domain, and never to a free email provider.
      allow update: if isAdmin(cid)
        && onlyChanges(['name', 'inviteCode', 'joinOpen', 'domain', 'listOnly', 'twoAdmins'])
        && text(request.resource.data.name, 60)
        && validInvite(request.resource.data.inviteCode)
        && request.resource.data.joinOpen is bool
        && request.resource.data.get('listOnly', false) is bool
        && request.resource.data.get('twoAdmins', false) is bool
        && (!changed().hasAny(['domain'])
            || request.resource.data.get('domain', null) == null
            || (validDomain(request.resource.data.domain) && request.resource.data.domain == myDomain()))
        && (!changed().hasAny(['domain', 'listOnly', 'twoAdmins']) || resource.data.type == 'org');

      allow delete: if false;

      // ---------- members ----------
      match /members/{uid} {
        allow read: if isMember(cid) || (signedIn() && uid == me());

        allow create: if signedIn() && uid == me()
          && request.resource.data.keys().hasOnly(['uid', 'name', 'title', 'email', 'role', 'status', 'device', 'inviteCode', 'joinedAt'])
          && request.resource.data.uid == me()
          && text(request.resource.data.name, 60)
          && text(request.resource.data.title, 40)
          && request.resource.data.email == request.auth.token.email
          && validDevice(request.resource.data.device, 1)
          && request.resource.data.joinedAt == request.time
          && (
            // the owner, while creating the circle
            (request.resource.data.role == 'admin' && request.resource.data.status == 'active'
              && !exists(circlePath(cid))
              && getAfter(circlePath(cid)).data.ownerUid == me())
            ||
            // someone joining with the current invite code: pending until approved
            (request.resource.data.role == 'member' && request.resource.data.status == 'pending'
              && get(circlePath(cid)).data.joinOpen == true
              && joinAllowed(cid)
              && request.resource.data.inviteCode == get(circlePath(cid)).data.inviteCode
              && getAfter(circlePath(cid)).data.memberCount == get(circlePath(cid)).data.memberCount + 1)
          );

        // You can change your title, or register a new device. The device counter always goes up,
        // so everyone sees the change, and non-admins go back to "pending" until an admin re-approves
        // them (so a stolen password alone can't produce trusted answers).
        // Your UPI ID for "Pay safely": only you can set it, from your own account, and the time
        // of the change is recorded so payers are warned about a recent change.
        // Your profile photo, shown next to your name in the circle.
        allow update: if signedIn() && uid == me()
          && onlyChanges(['photo'])
          && validPhoto(request.resource.data.photo);

        allow update: if signedIn() && uid == me()
          && onlyChanges(['upi', 'upiAt'])
          && (request.resource.data.upi == null || validUpi(request.resource.data.upi))
          && request.resource.data.upiAt == request.time;

        allow update: if signedIn() && uid == me()
          && onlyChanges(['title', 'device', 'status'])
          && text(request.resource.data.title, 40)
          && (
            (request.resource.data.device == resource.data.device
              && request.resource.data.status == resource.data.status)
            ||
            (validDevice(request.resource.data.device, resource.data.device.n + 1)
              && ((resource.data.role == 'admin' && request.resource.data.status == resource.data.status)
                  || (resource.data.role != 'admin' && request.resource.data.status == 'pending')))
          );

        // Admins approve pending members. With two-admin approval on, one admin approves first
        // (for this device) and a different admin completes it.
        allow update: if isAdmin(cid) && uid != me()
          && resource.data.status == 'pending'
          && (
            (!twoAdmins(cid)
              && request.resource.data.status == 'active'
              && onlyChanges(['status', 'approvedBy', 'approvedAt'])
              && request.resource.data.approvedBy == me()
              && request.resource.data.approvedAt == request.time)
            ||
            (twoAdmins(cid)
              && request.resource.data.status == 'pending'
              && onlyChanges(['firstApproval'])
              && request.resource.data.firstApproval == { 'by': me(), 'n': resource.data.device.n, 'at': request.time })
            ||
            (twoAdmins(cid)
              && request.resource.data.status == 'active'
              && onlyChanges(['status', 'approvedBy', 'approvedAt'])
              && resource.data.get('firstApproval', null) != null
              && resource.data.firstApproval.by != me()
              && resource.data.firstApproval.n == resource.data.device.n
              && request.resource.data.approvedBy == me()
              && request.resource.data.approvedAt == request.time)
          );

        // The circle's owner can make an approved member an admin, or turn an admin back into a member.
        allow update: if isAdmin(cid) && uid != me()
          && get(circlePath(cid)).data.ownerUid == me()
          && resource.data.status == 'active'
          && onlyChanges(['role'])
          && request.resource.data.role in ['admin', 'member'];

        // Leave, or be removed by an admin. Admins can't be removed or leave (so a circle is never orphaned).
        allow delete: if signedIn() && resource.data.role != 'admin' && (uid == me() || isAdmin(cid))
          && getAfter(circlePath(cid)).data.memberCount == get(circlePath(cid)).data.memberCount - 1;
      }

      // ---------- private chat (end-to-end encrypted) ----------
      // One conversation per pair, named "uidA~uidB" (sorted). Only those two people can read
      // or write it, never other members or admins. Messages are encrypted on the devices; the
      // database only checks who, when and how big. Messages can't be edited; the sender can delete.
      // Kinds: m message, f file, p payment (counts as a payment), c payment confirmation (paid / received).
      match /chats/{pid} {
        function pair() { return pid.split('~'); }
        function inPair() { return pair().size() == 2 && pair()[0] < pair()[1] && me() in pair(); }
        function other() { return pair()[0] == me() ? pair()[1] : pair()[0]; }
        function canTalk() { return isMember(cid) && inPair() && activeMember(cid, other()); }
        function chatPath() { return /databases/$(database)/documents/circles/$(cid)/chats/$(pid); }

        allow get: if isMember(cid) && inPair();
        allow list: if isMember(cid) && me() in resource.data.members;
        allow create, update: if canTalk()
          && request.resource.data.keys().hasOnly(['members', 'lastAt', 'lastFrom', 'lastKind'])
          && request.resource.data.members == pair()
          && request.resource.data.lastAt == request.time
          && request.resource.data.lastFrom == me()
          && request.resource.data.lastKind in ['m', 'f', 'p', 'c']
          && metered(request.resource.data.lastKind);
        allow delete: if false;

        match /msgs/{mid} {
          function msgPath() { return /databases/$(database)/documents/circles/$(cid)/chats/$(pid)/msgs/$(mid); }
          allow read: if isMember(cid) && inPair();
          allow create: if canTalk()
            && request.resource.data.keys().hasOnly(['from', 'to', 'kind', 'ct', 'iv', 'kf', 'parts', 'at'])
            && request.resource.data.from == me()
            && request.resource.data.to == other()
            && request.resource.data.at == request.time
            && request.resource.data.kind in ['m', 'f', 'p', 'c']
            && request.resource.data.ct is string && request.resource.data.ct.size() > 0 && request.resource.data.ct.size() <= 24000
            && request.resource.data.iv is string && request.resource.data.iv.matches('^[A-Za-z0-9+/]{16}$')
            && request.resource.data.kf is string && request.resource.data.kf.size() <= 40
            && (request.resource.data.kind == 'f'
                ? (request.resource.data.parts is int && request.resource.data.parts >= 1 && request.resource.data.parts <= 4)
                : !('parts' in request.resource.data))
            && metered(request.resource.data.kind)
            && getAfter(chatPath()).data.lastAt == request.time;
          allow delete: if isMember(cid) && inPair() && resource.data.from == me();
          allow update: if false;

          // Encrypted pieces of a file (up to 4 × 512 KB), written together with their message.
          match /parts/{i} {
            allow read: if isMember(cid) && inPair();
            allow create: if canTalk() && i in ['0', '1', '2', '3']
              && request.resource.data.keys().hasOnly(['ct', 'iv'])
              && request.resource.data.ct is string && request.resource.data.ct.size() <= 760000
              && request.resource.data.iv is string && request.resource.data.iv.matches('^[A-Za-z0-9+/]{16}$')
              && getAfter(msgPath()).data.from == me()
              && getAfter(msgPath()).data.at == request.time
              && getAfter(msgPath()).data.kind == 'f'
              && int(i) < getAfter(msgPath()).data.parts;
            allow delete: if isMember(cid) && inPair() && get(msgPath()).data.from == me();
            allow update: if false;
          }
        }
      }

      // ---------- contact numbers ----------
      // Your mobile number, shown only to the circle's admins (so they can recognise you before
      // approving), never to other members. It must be the number on your own profile.
      match /contacts/{uid} {
        allow read: if isAdmin(cid) || (signedIn() && uid == me());
        // "v": the number was verified by SMS (only the Verth server can mark a profile's number verified).
        allow create, update: if signedIn() && uid == me()
          && request.resource.data.keys().hasOnly(['phone', 'v'])
          && validPhone(request.resource.data.phone)
          && request.resource.data.phone == get(/databases/$(database)/documents/users/$(me())).data.get('phone', '')
          && (!('v' in request.resource.data)
              || (request.resource.data.v == true
                  && get(/databases/$(database)/documents/users/$(me())).data.get('phoneVerified', '') == request.resource.data.phone))
          && existsAfter(memberPath(cid, me()));
        allow delete: if signedIn() && (uid == me() || isAdmin(cid));
      }

      // ---------- staff list (organisations) ----------
      // Emails the admins allow to ask to join, when "only people on the list" is on.
      match /allow/{email} {
        allow read: if isAdmin(cid);
        allow create: if isAdmin(cid)
          && get(circlePath(cid)).data.type == 'org'
          && email.size() <= 120 && email.matches('^[a-z0-9._%+-]+@[a-z0-9-]+([.][a-z0-9-]+)+$')
          && request.resource.data.keys().hasOnly(['name', 'by', 'at'])
          && (!('name' in request.resource.data) || text(request.resource.data.name, 60))
          && request.resource.data.by == me()
          && request.resource.data.at == request.time;
        allow delete: if isAdmin(cid);
        allow update: if false;
      }

      // ---------- checks (the verification log) ----------
      match /checks/{checkId} {
        allow read: if isMember(cid);

        allow create: if isMember(cid)
          && throttledCheck()
          && request.resource.data.fromUid == me()
          && request.resource.data.toUid is string
          && request.resource.data.toUid != me()
          && activeMember(cid, request.resource.data.toUid)
          && request.resource.data.fromName == get(memberPath(cid, me())).data.name
          && request.resource.data.toName == get(memberPath(cid, request.resource.data.toUid)).data.name
          && request.resource.data.channel in channels()
          && text(request.resource.data.summary, 200)
          && request.resource.data.createdAt == request.time
          && (
            (request.resource.data.kind == 'push'
              && request.resource.data.keys().hasOnly(['kind', 'fromUid', 'fromName', 'toUid', 'toName', 'channel', 'summary', 'status', 'createdAt', 'expiresAt'])
              && request.resource.data.status == 'pending'
              && request.resource.data.expiresAt is timestamp
              && request.resource.data.expiresAt > request.time
              && request.resource.data.expiresAt <= request.time + duration.value(10, 'm'))
            ||
            (request.resource.data.kind == 'code'
              && request.resource.data.keys().hasOnly(['kind', 'fromUid', 'fromName', 'toUid', 'toName', 'channel', 'summary', 'status', 'createdAt'])
              && request.resource.data.status in ['code-match', 'code-mismatch'])
          );

        allow update: if isMember(cid) && (
          // Only the named person answers, once, before expiry, with a device signature.
          (resource.data.kind == 'push'
            && resource.data.toUid == me()
            && resource.data.status == 'pending'
            && request.time < resource.data.expiresAt
            && request.resource.data.status in ['confirmed', 'denied']
            && onlyChanges(['status', 'answeredAt', 'sig', 'sigN'])
            && request.resource.data.answeredAt == request.time
            && request.resource.data.sig is string
            && request.resource.data.sig.size() >= 80 && request.resource.data.sig.size() <= 100
            && request.resource.data.sigN == get(memberPath(cid, me())).data.device.n)
          ||
          // The person who asked can flag it as reported.
          (resource.data.fromUid == me()
            && onlyChanges(['reported'])
            && request.resource.data.reported == true)
        );

        allow delete: if false;
      }
    }
  }
}
